# Frontend (safe to expose in the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server functions only (never prefix with VITE_)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5

# Supabase authentication in Vercel Functions
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Cloudflare R2 (server functions only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional public base URL if the bucket is public
# R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
